{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/serve-static.mjs",
    "lint": "oxlint src app cloud scripts tests vite.config.ts next.config.ts",
    "format": "oxfmt",
    "preview": "node scripts/serve-static.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check:release": "npm run typecheck && npm test && npm run build && npm run check:static",
    "analyze:model": "node --import tsx scripts/model-sensitivity.ts",
    "check:static": "node scripts/check-static.mjs",
    "cf": "node scripts/cloudflare.mjs",
    "build:saas": "node scripts/build-saas.mjs",
    "dev:saas": "node scripts/cloudflare.mjs dev --env= --persist-to ../work/cloudflare-state",
    "check:cloud": "tsc --noEmit --incremental false",
    "deploy:staging": "node scripts/deploy-saas.mjs staging",
    "deploy:production": "node scripts/deploy-saas.mjs production",
    "check:saas": "npm run typecheck && npm run lint && npm test && npm run build:saas && node scripts/cloudflare.mjs deploy --env staging --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  },
  "type": "module"
}
